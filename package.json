{
  "name": "souschef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor,storage-api,postgres-meta",
    "test:db:start": "node scripts/test-db.mjs start -x studio,imgproxy,logflare,vector,supavisor,storage-api,postgres-meta",
    "test:db:reset": "node scripts/test-db.mjs db reset",
    "test:db:stop": "node scripts/test-db.mjs stop",
    "verify": "npm run check && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.118.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
